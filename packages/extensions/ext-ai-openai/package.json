{
  "name": "@openorbit/ext-ai-openai",
  "version": "1.0.0",
  "description": "OpenAI (GPT) AI provider extension",
  "type": "module",
  "main": "./src/main/index.ts",
  "keywords": ["openorbit-extension"],
  "openorbit": {
    "id": "ext-ai-openai",
    "displayName": "OpenAI (GPT)",
    "category": "ai",
    "icon": "sparkles",
    "activationEvents": ["onStartup"],
    "main": "./src/main/index.ts",
    "renderer": "./src/renderer/index.ts",
    "contributes": {
      "settings": [
        { "key": "openai_api_keys", "label": "API Keys", "type": "password-list", "description": "OpenAI API keys (sk-...). Add multiple keys for round-robin rotation." }
      ]
    }
  },
  "dependencies": {
    "@openorbit/core": "*"
  }
}
