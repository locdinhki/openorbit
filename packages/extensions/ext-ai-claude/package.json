{
  "name": "@openorbit/ext-ai-claude",
  "version": "1.0.0",
  "description": "Claude (Anthropic) AI provider extension",
  "type": "module",
  "main": "./src/main/index.ts",
  "keywords": ["openorbit-extension"],
  "openorbit": {
    "id": "ext-ai-claude",
    "displayName": "Claude (Anthropic)",
    "category": "ai",
    "icon": "message-circle",
    "activationEvents": ["onStartup"],
    "main": "./src/main/index.ts",
    "renderer": "./src/renderer/index.ts",
    "contributes": {
      "settings": [
        { "key": "anthropic_api_keys", "label": "API Keys", "type": "password-list", "description": "Anthropic API keys (sk-ant-...). Add multiple keys for round-robin rotation." }
      ]
    }
  },
  "dependencies": {
    "@openorbit/core": "*"
  }
}
